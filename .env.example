# Copy to .env for local runs. In CI these are GitHub repo secrets.

# Subscription auth — no API billing. Generate with:  claude setup-token
# Produces a token starting sk-ant-oat01-...
CLAUDE_CODE_OAUTH_TOKEN=

GUARDIAN_API_KEY=            # open-platform.theguardian.com/access — free developer key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com      # MUST be on Amazon's Approved Personal Document E-mail List
SMTP_PASS=                   # app password, never your account password
KINDLE_EMAIL=you@kindle.com  # Manage Your Content & Devices > Preferences > Personal Document Settings

# Optional: override Claude Code CLI flags if a version rejects one of ours.
# --json-schema is always appended after these, so don't include it here.
# CLAUDE_CLI_ARGS=--max-turns 5 --effort medium
